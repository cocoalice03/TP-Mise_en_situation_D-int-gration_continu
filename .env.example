# Modèle du fichier .env local (copier : cp .env.example .env, puis remplir).
# .env est ignoré par git : ne jamais le commiter.
# Lu par Docker Compose et par l'application Python.
#
# En CI/CD, ces valeurs viennent de GitHub > Settings > Secrets and variables > Actions
#   secrets   : MYSQL_PASSWORD, MYSQL_ROOT_PASSWORD, MINIO_ROOT_PASSWORD
#   variables : MYSQL_USER, MYSQL_DATABASE, MINIO_ROOT_USER, MINIO_BUCKET,
#               (MYSQL_HOST, MYSQL_PORT, MINIO_ENDPOINT, RETRY_MAX_ATTEMPTS, RETRY_DELAY_SECONDS)

# --- MySQL ---
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
MYSQL_USER=
MYSQL_DATABASE=
MYSQL_HOST=localhost
MYSQL_PORT=3306

# --- MinIO (S3) ---
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=
MINIO_ENDPOINT=http://localhost:9000

# --- Retry (optionnel, valeurs par défaut : 3 tentatives, 2 s, backoff x2) ---
# RETRY_MAX_ATTEMPTS=3
# RETRY_DELAY_SECONDS=2
